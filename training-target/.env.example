# ╔══════════════════════════════════════════════════════════════════╗
# ║  HWP Training Target — Environment Configuration              ║
# ║  DO NOT EXPOSE TO THE INTERNET                                 ║
# ╚══════════════════════════════════════════════════════════════════╝

# Ports
WP_PORT=80
PMA_PORT=8080

# WordPress Database
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress

# MariaDB Root
MARIADB_ROOT_PASSWORD=rootpass

# WordPress Admin
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@hwp-training.local

# Site URL (must match WP_PORT)
WP_URL=http://localhost
